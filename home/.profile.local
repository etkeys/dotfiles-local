
export ANDROID_HOME="/home/erik/.local/bin/android-studio/android-sdk"
export ANDROID_AVD_HOME="/home/erik/.config/.android/avd"
export JAVA_HOME="/usr/lib/jvm/msopenjdk-17-amd64"
export S3_ENDPOINT="https://s3.us-west-002.backblazeb2.com"
export VMDIR="/mnt/vmdrive/erik"

if [ -n "$DESKTOP_SESSION" ] ; then
    export XDG_CONFIG_HOME="$HOME/.config"
fi


if [ -n "$DESKTOP_SESSION" ] && [ "$DESKTOP_SESSION" = "i3" ] ; then 
   # setleds -D +num
    xset r rate 1000 10
    xset dpms 0 0 600
    xmodmap "$HOME/.Xmodmap"
fi

if [ -d "$HOME/repos/scripts" ] ; then
    PATH="$PATH:$HOME/repos/scripts"
fi

if [ -d "$HOME/.local/bin/dotnet" ] ; then
    export DOTNET_ROOT=$HOME/.local/bin/dotnet
    PATH=$PATH:$DOTNET_ROOT:$DOTNET_ROOT/tools
fi

